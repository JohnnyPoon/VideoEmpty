<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:VideoEmpty.Core.Model"
        xmlns:local="using:VideoEmpty.UI"
        x:Class="VideoEmpty.UI.MainWindow"
        Title="VideoEmpty" Width="1360" Height="860">
    <Window.Styles>
        <!-- Hide action icon buttons by default; reveal when the row is hovered. -->
        <Style Selector="ListBoxItem StackPanel.item-actions">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover StackPanel.item-actions">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Make the small icon buttons compact and low-key. -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Styles>
    <Grid>
        <DockPanel x:Name="DashboardRoot" IsVisible="True" Margin="12">
            <TextBlock DockPanel.Dock="Top" Text="VideoEmpty Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                <Button x:Name="DashboardNewProjectButton" Content="New Project…"/>
                <Button x:Name="DashboardOpenProjectButton" Content="Open Project…"/>
                <Button x:Name="DashboardOpenLogButton" Content="Open Log"/>
            </StackPanel>
            <TextBlock Text="Recent Projects" FontWeight="Bold" Margin="0,4,0,8"/>
            <ListBox x:Name="RecentProjectsList">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:RecentProjectItem">
                        <Grid ColumnDefinitions="*,Auto" Margin="2,4">
                            <StackPanel Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Spacing="2" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Created" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding CreatedLabel}" FontSize="10" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Updated" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel x:Name="EditorRoot" IsVisible="False">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
                <Button x:Name="DashboardButton" Content="Dashboard"/>
                <Button x:Name="OpenVideoButton" Content="Open Video…"/>
                <Button x:Name="SaveProjectButton" Content="Save Project…"/>
                <Button x:Name="UndoButton" Content="Undo"/>
                <Button x:Name="ExportButton" Content="Export…"/>
                <Button x:Name="SettingsButton" Content="Settings…"/>
                <Button x:Name="InstallDepsButton" Content="Install FFmpeg…" IsVisible="False"/>
                <Button x:Name="OpenLogButton" Content="Open Log"/>
                <TextBlock x:Name="VideoInfoLabel" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Background="#222" Padding="6,3">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="ArmedLabel" Foreground="White" Text="(none armed)"/>
                    <TextBlock x:Name="TimeLabel" Foreground="White"/>
                    <TextBlock x:Name="ExportStatus" Foreground="LightGreen"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="360,*,340">
                <Border Grid.Column="0" BorderBrush="#444" BorderThickness="0,0,1,0" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Templates" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                            <Button x:Name="AddTemplateButton" Content="Add"/>
                            <Button x:Name="DuplicateTemplateButton" Content="Duplicate"/>
                            <Button x:Name="DeleteTemplateButton" Content="Delete"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" x:Name="TemplateEditor" Spacing="4" IsVisible="False" Margin="0,8,0,0">
                            <TextBlock Text="Selected template" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                                <TextBlock Text="Name"/> <TextBox Grid.Column="1" x:Name="TemplateNameBox"/>
                                <TextBlock Grid.Row="1" Text="Width"/> <TextBox Grid.Row="1" Grid.Column="1" x:Name="TemplateWidthBox"/>
                                <TextBlock Grid.Row="2" Text="Height"/> <TextBox Grid.Row="2" Grid.Column="1" x:Name="TemplateHeightBox"/>
                                <TextBlock Grid.Row="3" Text="Default ms"/> <TextBox Grid.Row="3" Grid.Column="1" x:Name="TemplateDurationBox"/>
                                <TextBlock Grid.Row="4" Text="Enter"/> <ComboBox Grid.Row="4" Grid.Column="1" x:Name="TemplateEnterBox"/>
                                <TextBlock Grid.Row="5" Text="Exit"/> <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TemplateExitBox"/>
                                <TextBlock Grid.Row="6" Text="Enter/Exit ms"/> <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="4"><TextBox x:Name="TemplateEnterMsBox" Width="80"/><TextBox x:Name="TemplateExitMsBox" Width="80"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Template JSON (full element-level editor)"/>
                            <TextBox x:Name="TemplateJsonBox" AcceptsReturn="True" Height="170" TextWrapping="NoWrap" FontFamily="Consolas"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="ApplyTemplateButton" Content="Apply Fields"/>
                                <Button x:Name="ApplyTemplateJsonButton" Content="Apply JSON"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="TemplatesList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="model:Template">
                                    <Grid ColumnDefinitions="*,Auto" MinHeight="26">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                    Classes="item-actions" VerticalAlignment="Center">
                                            <Button Classes="icon-btn" Content="⧉" ToolTip.Tip="Duplicate"
                                                    Tag="{Binding Id}" Click="OnTemplateItemDuplicate"/>
                                            <Button Classes="icon-btn" Content="✕" ToolTip.Tip="Delete"
                                                    Tag="{Binding Id}" Click="OnTemplateItemDelete"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Column="1" Margin="6">
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,4,0,0">
                        <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" Value="0"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Button x:Name="JumpBack10sButton"  Content="«10s" ToolTip.Tip="Back 10 seconds"/>
                            <Button x:Name="JumpBack1sButton"   Content="«1s"  ToolTip.Tip="Back 1 second"/>
                            <Button x:Name="StepBackButton"     Content="◄|"   ToolTip.Tip="Previous frame"/>
                            <Button x:Name="PlayPauseButton"    Content="▶ Play" MinWidth="80"/>
                            <Button x:Name="StepForwardButton"  Content="|►"   ToolTip.Tip="Next frame"/>
                            <Button x:Name="JumpForward1sButton" Content="1s»" ToolTip.Tip="Forward 1 second"/>
                            <Button x:Name="JumpForward10sButton" Content="10s»" ToolTip.Tip="Forward 10 seconds"/>
                            <CheckBox x:Name="LoopCheck" Content="Loop" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock x:Name="PlaybackTimeLabel" VerticalAlignment="Center" Margin="12,0,0,0" Text="0:00.000 / 0:00.000"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#111">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2" Margin="6">
                    <TextBlock DockPanel.Dock="Top" Text="Instances" FontWeight="Bold"/>
                    <StackPanel x:Name="InstanceEditor" DockPanel.Dock="Bottom" Spacing="4" IsVisible="False" Margin="0,8,0,0">
                        <TextBlock Text="Selected instance" FontWeight="Bold"/>
                        <TextBlock x:Name="InstanceTemplateNameLabel" FontSize="11" Foreground="Gray"/>
                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <TextBlock Text="Start ms"/>      <TextBox Grid.Column="1" x:Name="InstanceStartBox"/>
                            <TextBlock Grid.Row="1" Text="Duration ms"/> <TextBox Grid.Row="1" Grid.Column="1" x:Name="InstanceDurationBox"/>
                            <TextBlock Grid.Row="2" Text="Center X"/>    <TextBox Grid.Row="2" Grid.Column="1" x:Name="InstanceXBox"/>
                            <TextBlock Grid.Row="3" Text="Center Y"/>    <TextBox Grid.Row="3" Grid.Column="1" x:Name="InstanceYBox"/>
                            <TextBlock Grid.Row="4" Text="Text"/>        <TextBox Grid.Row="4" Grid.Column="1" x:Name="InstanceTextBox" AcceptsReturn="True" Height="80"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ApplyInstanceButton" Content="Apply"/>
                            <Button x:Name="PreviewInstanceButton" Content="▶ Jump to" ToolTip.Tip="Jump video to start of this instance"/>
                            <Button x:Name="DeleteInstanceButton" Content="Delete"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="InstancesList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:InstanceListItem">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="12"/>
                                        <TextBlock Text="{Binding TemplateName}" FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                Classes="item-actions" VerticalAlignment="Center">
                                        <Button Classes="icon-btn" Content="▶" ToolTip.Tip="Jump to start"
                                                Tag="{Binding Instance.Id}" Click="OnInstanceItemPreview"/>
                                        <Button Classes="icon-btn" Content="✕" ToolTip.Tip="Delete"
                                                Tag="{Binding Instance.Id}" Click="OnInstanceItemDelete"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
